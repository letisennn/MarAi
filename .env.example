# Copy to .env and fill in. No secrets are required for v0.1 (yfinance/Stooq are
# keyless). Keys below are placeholders for later versions — do not wire in any
# paid source without sign-off (see CLAUDE.md).

MARC_DB_PATH=data/marc.duckdb
MARC_BASE_CURRENCY=SEK
MARC_LOG_LEVEL=INFO

# --- inloggning (app/_gate.py) ---
# Sätt båda för att kräva inloggning (lokalt eller hostat). Utan dem satta
# släpps Jonas igenom automatiskt — bekvämt för lokal utveckling, men sätt
# alltid dessa på en hostad/delad länk. Styr vems separata pappersportfölj
# (marc.paper) man handlar i — se inte som riktig säkerhet.
MARC_USER_JONAS_PASSWORD=
MARC_USER_HUGO_PASSWORD=

# --- deferred / optional ---
# OPENFIGI_API_KEY=            # free, raises rate limits; v0.1 symbology
# BORSDATA_API_KEY=            # paid — do not use without sign-off
# EODHD_API_KEY=               # paid — do not use without sign-off
# ANTHROPIC_API_KEY=           # marc.llm.narrative (2026-09-16 exception to rule 4,
                                # see CLAUDE.md) — `marc llm-narrative "<bolag>"`.
                                # Costs real money per call (small, per-token).
